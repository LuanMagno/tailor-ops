{
  "name": "tailor-ops",
  "version": "1.0.0",
  "private": true,
  "description": "ATS Resume Tailoring & Application Backlog with SRE Observability on Google Apps Script + Gemini API",
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "push": "clasp push",
    "watch": "clasp push --watch",
    "open": "clasp open",
    "logs": "clasp logs",
    "deploy:update": "clasp push --force && clasp deploy"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "eslint": "^10.15.0",
    "vitest": "^5.1.2"
  }
}
