/**
 * Pure domain logic and validation helpers shared between Google Apps Script (V8)
 * and Node.js/Vitest unit tests.
 *
 * NOTE: Keep this file strictly pure (no Apps Script services, no Node APIs,
 * no browser globals, no URL constructor).
 */

const APPLICATION_STATUSES = Object.freeze([
  'Gerado',
  'Aplicado',
  'Em Andamento',
  'Proposta',
  'Rejeitado',
  'Desisti',
  'Empresa não retornou',
]);

const BOOKMARKLET_PREFIX = 'TAILOROPS_CAPTURE::';
const MAX_BOOKMARKLET_TEXT_LENGTH = 25000;
const MAX_FILENAME_SEGMENT_LENGTH = 60;
const RETRYABLE_HTTP_STATUSES = Object.freeze([429, 500, 502, 503, 504]);

/**
 * Checks whether a value is a non-null plain object (not an array).
 * @param {*} value
 * @returns {boolean}
 */
function isPlainObject(value) {
  return value !== null && typeof value === 'object' && !Array.isArray(value);
}

/**
 * Checks whether a value is a non-empty string after trimming.
 * @param {*} value
 * @returns {boolean}
 */
function isNonEmptyString(value) {
  return typeof value === 'string' && value.trim().length > 0;
}

/**
 * Checks whether a value is an array containing only non-empty strings.
 * @param {*} value
 * @param {{ allowEmpty?: boolean }} [options]
 * @returns {boolean}
 */
function isStringArray(value, options) {
  if (!Array.isArray(value)) {
    return false;
  }
  const allowEmpty = options && options.allowEmpty === true;
  if (!allowEmpty && value.length === 0) {
    return false;
  }
  return value.every((item) => isNonEmptyString(item));
}

/**
 * Validates if a status matches one of the 7 allowed Backlog statuses.
 * @param {string} status
 * @returns {boolean}
 */
function isValidApplicationStatus(status) {
  return typeof status === 'string' && APPLICATION_STATUSES.includes(status);
}

/**
 * Validates an HTTP/HTTPS URL string without relying on Node/Browser URL constructors.
 * @param {string} url
 * @returns {boolean}
 */
function isValidHttpUrl(url) {
  if (!isNonEmptyString(url)) {
    return false;
  }
  return /^https?:\/\/[^\s/$.?#].[^\s]*$/i.test(url.trim());
}

/**
 * Sanitizes a segment for safe use in Google Drive / filesystem filenames.
 * @param {string} value
 * @param {string} fallback
 * @returns {string}
 */
function sanitizeFilenameSegment(value, fallback) {
  const safeFallback = isNonEmptyString(fallback) ? fallback.trim() : 'Item';
  if (typeof value !== 'string') {
    return safeFallback;
  }

  let cleaned = '';
  for (let i = 0; i < value.length; i += 1) {
    const code = value.charCodeAt(i);
    if (code >= 32 && code !== 127) {
      cleaned += value[i];
    }
  }

  cleaned = cleaned
    .replace(/[/\\:*?"<>|]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .replace(/^\.+|\.+$/g, '')
    .trim();

  if (cleaned.length > MAX_FILENAME_SEGMENT_LENGTH) {
    cleaned = cleaned.slice(0, MAX_FILENAME_SEGMENT_LENGTH).trim();
  }

  return cleaned.length > 0 ? cleaned : safeFallback;
}

/**
 * Builds the exact output Google Doc filename specified in Section 4.1:
 * "CV- Luan Magno - {Empresa} - {Cargo}".
 * @param {string} company
 * @param {string} role
 * @returns {string}
 */
function buildResumeFilename(company, role) {
  const safeCompany = sanitizeFilenameSegment(company, 'Empresa');
  const safeRole = sanitizeFilenameSegment(role, 'Cargo');
  return `CV- Luan Magno - ${safeCompany} - ${safeRole}`;
}

/**
 * Parses and validates a clipboard payload generated by the TailorOps bookmarklet.
 * @param {string} rawText
 * @returns {{
 *   ok: boolean,
 *   data?: { url: string, title: string, text: string, capturedAt: string },
 *   errorCode?: 'INVALID_PREFIX' | 'INVALID_JSON' | 'INVALID_PAYLOAD',
 *   message?: string
 * }}
 */
function parseBookmarkletPayload(rawText) {
  if (typeof rawText !== 'string') {
    return {
      ok: false,
      errorCode: 'INVALID_PREFIX',
      message: 'Payload do bookmarklet deve ser uma string.',
    };
  }

  const trimmed = rawText.trim();
  if (!trimmed.startsWith(BOOKMARKLET_PREFIX)) {
    return {
      ok: false,
      errorCode: 'INVALID_PREFIX',
      message: `Payload não inicia com o prefixo esperado ${BOOKMARKLET_PREFIX}.`,
    };
  }

  const jsonPart = trimmed.slice(BOOKMARKLET_PREFIX.length).trim();
  let parsed;
  try {
    parsed = JSON.parse(jsonPart);
  } catch {
    return {
      ok: false,
      errorCode: 'INVALID_JSON',
      message: 'Conteúdo JSON após o prefixo do bookmarklet é inválido.',
    };
  }

  if (!isPlainObject(parsed)) {
    return {
      ok: false,
      errorCode: 'INVALID_PAYLOAD',
      message: 'Payload do bookmarklet deve ser um objeto JSON.',
    };
  }

  const rawUrl = typeof parsed.url === 'string' ? parsed.url : parsed.jobUrl;
  if (!isValidHttpUrl(rawUrl)) {
    return {
      ok: false,
      errorCode: 'INVALID_PAYLOAD',
      message: 'URL da vaga ausente ou inválida no payload do bookmarklet.',
    };
  }

  const title = typeof parsed.title === 'string' ? parsed.title.trim() : '';
  const rawContent = typeof parsed.text === 'string'
    ? parsed.text
    : (typeof parsed.content === 'string' ? parsed.content : '');
  const text = rawContent.trim().slice(0, MAX_BOOKMARKLET_TEXT_LENGTH);
  const capturedAt = typeof parsed.capturedAt === 'string' ? parsed.capturedAt.trim() : '';

  return {
    ok: true,
    data: {
      url: rawUrl.trim(),
      title,
      text,
      capturedAt,
    },
  };
}

/**
 * Validates the JSON schema returned by Gemini for Step 1 (`analyzeJob`).
 * @param {object} payload
 * @returns {{ valid: boolean, errors: string[] }}
 */
function validateAnalysisResult(payload) {
  const errors = [];

  if (!isPlainObject(payload)) {
    return { valid: false, errors: ['Payload de análise deve ser um objeto.'] };
  }

  if (!isNonEmptyString(payload.company)) {
    errors.push('Campo "company" deve ser uma string não vazia.');
  }
  if (!isNonEmptyString(payload.role)) {
    errors.push('Campo "role" deve ser uma string não vazia.');
  }
  if (payload.language !== 'PT' && payload.language !== 'EN') {
    errors.push('Campo "language" deve ser "PT" ou "EN".');
  }
  if (!isStringArray(payload.keywords)) {
    errors.push('Campo "keywords" deve ser um array não vazio de strings.');
  }

  if (!isPlainObject(payload.gapAnalysis)) {
    errors.push('Campo "gapAnalysis" deve ser um objeto.');
  } else {
    const gapFields = ['hasPracticalContext', 'underHighlighted', 'realGaps'];
    gapFields.forEach((field) => {
      if (!isStringArray(payload.gapAnalysis[field], { allowEmpty: true })) {
        errors.push(`Campo "gapAnalysis.${field}" deve ser um array de strings.`);
      }
    });
  }

  if (!Array.isArray(payload.validationQuestions)) {
    errors.push('Campo "validationQuestions" deve ser um array.');
  } else {
    payload.validationQuestions.forEach((item, index) => {
      if (!isPlainObject(item)) {
        errors.push(`"validationQuestions[${index}]" deve ser um objeto.`);
        return;
      }
      if (!isNonEmptyString(item.id)) {
        errors.push(`"validationQuestions[${index}].id" deve ser uma string não vazia.`);
      }
      if (!isNonEmptyString(item.technology)) {
        errors.push(`"validationQuestions[${index}].technology" deve ser uma string não vazia.`);
      }
      if (!isNonEmptyString(item.reason)) {
        errors.push(`"validationQuestions[${index}].reason" deve ser uma string não vazia.`);
      }
      if (!isNonEmptyString(item.question)) {
        errors.push(`"validationQuestions[${index}].question" deve ser uma string não vazia.`);
      }
      if (typeof item.suggestedDefault !== 'boolean') {
        errors.push(`"validationQuestions[${index}].suggestedDefault" deve ser booleano.`);
      }
    });
  }

  if (!isNonEmptyString(payload.extractedJobSummary)) {
    errors.push('Campo "extractedJobSummary" deve ser uma string não vazia.');
  }

  return {
    valid: errors.length === 0,
    errors,
  };
}

/**
 * Validates the JSON schema returned by Gemini for Step 2 (`generateResume`).
 * @param {object} payload
 * @returns {{ valid: boolean, errors: string[] }}
 */
function validateGeneratedResume(payload) {
  const errors = [];

  if (!isPlainObject(payload)) {
    return { valid: false, errors: ['Payload do currículo gerado deve ser um objeto.'] };
  }

  if (payload.language !== 'PT' && payload.language !== 'EN') {
    errors.push('Campo "language" deve ser "PT" ou "EN".');
  }
  if (!isNonEmptyString(payload.summary)) {
    errors.push('Campo "summary" deve ser uma string não vazia.');
  }

  if (!Array.isArray(payload.experiences) || payload.experiences.length === 0) {
    errors.push('Campo "experiences" deve ser um array não vazio.');
  } else {
    payload.experiences.forEach((exp, index) => {
      if (!isPlainObject(exp)) {
        errors.push(`"experiences[${index}]" deve ser um objeto.`);
        return;
      }
      if (!isNonEmptyString(exp.company)) {
        errors.push(`"experiences[${index}].company" deve ser uma string não vazia.`);
      }
      if (!isNonEmptyString(exp.role)) {
        errors.push(`"experiences[${index}].role" deve ser uma string não vazia.`);
      }
      if (!isNonEmptyString(exp.period)) {
        errors.push(`"experiences[${index}].period" deve ser uma string não vazia.`);
      }
      if (!isStringArray(exp.bullets)) {
        errors.push(`"experiences[${index}].bullets" deve ser um array não vazio de strings.`);
      }
    });
  }

  if (!isStringArray(payload.skills)) {
    errors.push('Campo "skills" deve ser um array não vazio de strings.');
  } else {
    payload.skills.forEach((line, index) => {
      const colonIdx = line.indexOf(':');
      if (colonIdx <= 0 || colonIdx === line.length - 1) {
        errors.push(`"skills[${index}]" deve conter rótulo e valores separados por ":".`);
      } else {
        const label = line.slice(0, colonIdx).trim();
        const items = line.slice(colonIdx + 1).trim();
        if (label.length === 0 || items.length === 0) {
          errors.push(`"skills[${index}]" deve ter texto não vazio antes e depois de ":".`);
        }
      }
      if (/\(\s*em\s+(estudo|aprendizado)\s*\)/i.test(line)) {
        errors.push(`"skills[${index}]" não pode conter "(Em estudo)" ou "(em aprendizado)".`);
      }
    });
  }

  if (!isStringArray(payload.education)) {
    errors.push('Campo "education" deve ser um array não vazio de strings.');
  }
  if (!isNonEmptyString(payload.courses)) {
    errors.push('Campo "courses" deve ser uma string não vazia.');
  }
  if (!isStringArray(payload.highlightsSummary)) {
    errors.push('Campo "highlightsSummary" deve ser um array não vazio de strings.');
  }
  if (typeof payload.gapsSummary !== 'string') {
    errors.push('Campo "gapsSummary" deve ser uma string.');
  }

  return {
    valid: errors.length === 0,
    errors,
  };
}

/**
 * Checks whether an HTTP status code is eligible for retry with exponential backoff.
 * @param {number} statusCode
 * @returns {boolean}
 */
function isRetryableHttpStatus(statusCode) {
  return Number.isInteger(statusCode) && RETRYABLE_HTTP_STATUSES.includes(statusCode);
}

/**
 * Calculates exponential backoff delay with additive jitter in milliseconds.
 * @param {number} attempt Zero-based retry attempt index (0, 1, 2, ...).
 * @param {{
 *   baseDelayMs?: number,
 *   maxDelayMs?: number,
 *   jitterRatio?: number,
 *   randomFn?: () => number
 * }} [options]
 * @returns {number}
 */
function calculateBackoffDelayMs(attempt, options) {
  if (!Number.isInteger(attempt) || attempt < 0) {
    throw new RangeError('attempt deve ser um inteiro maior ou igual a 0.');
  }

  const opts = isPlainObject(options) ? options : {};
  const baseDelayMs = typeof opts.baseDelayMs === 'number' ? opts.baseDelayMs : 1000;
  const maxDelayMs = typeof opts.maxDelayMs === 'number' ? opts.maxDelayMs : 16000;
  const jitterRatio = typeof opts.jitterRatio === 'number' ? opts.jitterRatio : 0.25;
  const randomFn = typeof opts.randomFn === 'function' ? opts.randomFn : Math.random;

  const exponential = Math.min(maxDelayMs, baseDelayMs * Math.pow(2, attempt));
  const jitter = exponential * jitterRatio * randomFn();
  return Math.min(maxDelayMs, Math.round(exponential + jitter));
}

