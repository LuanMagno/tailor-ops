/**
 * Pure domain logic and validation helpers shared between Google Apps Script (V8)
 * and Node.js/Vitest unit tests.
 *
 * NOTE: Keep this file strictly pure (no Apps Script services, no Node APIs,
 * no browser globals, no URL constructor).
 */

const APPLICATION_STATUSES = Object.freeze([
  'Gerado',
  'Aplicado',
  'Em Andamento',
  'Proposta',
  'Rejeitado',
  'Desisti',
  'Empresa não retornou',
]);

const BOOKMARKLET_PREFIX = 'TAILOROPS_CAPTURE::';
const MAX_BOOKMARKLET_TEXT_LENGTH = 25000;
const MAX_FILENAME_SEGMENT_LENGTH = 60;
const MAX_SCREENSHOT_COUNT = 4;
const MAX_IMAGE_BASE64_LENGTH = 7000000;
const MAX_TOTAL_IMAGES_BASE64_LENGTH = 15000000;
const MIN_EXTRACTED_TEXT_LENGTH = 300;
const MAX_KEYWORDS = 15;
const ALLOWED_IMAGE_MIME_TYPES = Object.freeze(['image/png', 'image/jpeg', 'image/webp']);
const RETRYABLE_HTTP_STATUSES = Object.freeze([429, 500, 502, 503, 504]);

const SECTION_HEADINGS = Object.freeze({
  PT: Object.freeze({
    summary: 'RESUMO PROFISSIONAL',
    experience: 'EXPERIÊNCIA PROFISSIONAL',
    skills: 'HABILIDADES TÉCNICAS',
    education: 'FORMAÇÃO ACADÊMICA',
    courses: 'CURSOS RELEVANTES',
  }),
  EN: Object.freeze({
    summary: 'PROFESSIONAL SUMMARY',
    experience: 'PROFESSIONAL EXPERIENCE',
    skills: 'TECHNICAL SKILLS',
    education: 'EDUCATION',
    courses: 'RELEVANT COURSEWORK',
  }),
});

const BACKLOG_HEADERS = Object.freeze([
  'id',
  'created_at',
  'company',
  'role',
  'language',
  'status',
  'job_url',
  'doc_url',
  'pdf_url',
  'keywords_json',
  'highlights_summary',
  'gaps_summary',
  'notes',
  'metadata_json',
]);

/**
 * Checks whether a value is a non-null plain object (not an array).
 * @param {*} value
 * @returns {boolean}
 */
function isPlainObject(value) {
  return value !== null && typeof value === 'object' && !Array.isArray(value);
}

/**
 * Checks whether a value is a non-empty string after trimming.
 * @param {*} value
 * @returns {boolean}
 */
function isNonEmptyString(value) {
  return typeof value === 'string' && value.trim().length > 0;
}

/**
 * Checks whether a value is an array containing only non-empty strings.
 * @param {*} value
 * @param {{ allowEmpty?: boolean }} [options]
 * @returns {boolean}
 */
function isStringArray(value, options) {
  if (!Array.isArray(value)) {
    return false;
  }
  const allowEmpty = options && options.allowEmpty === true;
  if (!allowEmpty && value.length === 0) {
    return false;
  }
  return value.every((item) => isNonEmptyString(item));
}

/**
 * Validates if a status matches one of the 7 allowed Backlog statuses.
 * @param {string} status
 * @returns {boolean}
 */
function isValidApplicationStatus(status) {
  return typeof status === 'string' && APPLICATION_STATUSES.includes(status);
}

/**
 * Validates an HTTP/HTTPS URL string without relying on Node/Browser URL constructors.
 * @param {string} url
 * @returns {boolean}
 */
function isValidHttpUrl(url) {
  if (!isNonEmptyString(url)) {
    return false;
  }
  return /^https?:\/\/[^\s/$.?#].[^\s]*$/i.test(url.trim());
}

/**
 * Sanitizes a segment for safe use in Google Drive / filesystem filenames.
 * @param {string} value
 * @param {string} fallback
 * @returns {string}
 */
function sanitizeFilenameSegment(value, fallback) {
  const safeFallback = isNonEmptyString(fallback) ? fallback.trim() : 'Item';
  if (typeof value !== 'string') {
    return safeFallback;
  }

  let cleaned = '';
  for (let i = 0; i < value.length; i += 1) {
    const code = value.charCodeAt(i);
    if (code >= 32 && code !== 127) {
      cleaned += value[i];
    }
  }

  cleaned = cleaned
    .replace(/[/\\:*?"<>|]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .replace(/^\.+|\.+$/g, '')
    .trim();

  if (cleaned.length > MAX_FILENAME_SEGMENT_LENGTH) {
    cleaned = cleaned.slice(0, MAX_FILENAME_SEGMENT_LENGTH).trim();
  }

  return cleaned.length > 0 ? cleaned : safeFallback;
}

/**
 * Builds the exact output Google Doc filename specified in Section 4.1:
 * "CV- Luan Magno - {Empresa} - {Cargo}".
 * @param {string} company
 * @param {string} role
 * @returns {string}
 */
function buildResumeFilename(company, role) {
  const safeCompany = sanitizeFilenameSegment(company, 'Empresa');
  const safeRole = sanitizeFilenameSegment(role, 'Cargo');
  return `CV- Luan Magno - ${safeCompany} - ${safeRole}`;
}

/**
 * Parses and validates a clipboard payload generated by the TailorOps bookmarklet.
 * @param {string} rawText
 * @returns {{
 *   ok: boolean,
 *   data?: { url: string, title: string, text: string, capturedAt: string },
 *   errorCode?: 'INVALID_PREFIX' | 'INVALID_JSON' | 'INVALID_PAYLOAD',
 *   message?: string
 * }}
 */
function parseBookmarkletPayload(rawText) {
  if (typeof rawText !== 'string') {
    return {
      ok: false,
      errorCode: 'INVALID_PREFIX',
      message: 'Payload do bookmarklet deve ser uma string.',
    };
  }

  const trimmed = rawText.trim();
  if (!trimmed.startsWith(BOOKMARKLET_PREFIX)) {
    return {
      ok: false,
      errorCode: 'INVALID_PREFIX',
      message: `Payload não inicia com o prefixo esperado ${BOOKMARKLET_PREFIX}.`,
    };
  }

  const jsonPart = trimmed.slice(BOOKMARKLET_PREFIX.length).trim();
  let parsed;
  try {
    parsed = JSON.parse(jsonPart);
  } catch {
    return {
      ok: false,
      errorCode: 'INVALID_JSON',
      message: 'Conteúdo JSON após o prefixo do bookmarklet é inválido.',
    };
  }

  if (!isPlainObject(parsed)) {
    return {
      ok: false,
      errorCode: 'INVALID_PAYLOAD',
      message: 'Payload do bookmarklet deve ser um objeto JSON.',
    };
  }

  const rawUrl = typeof parsed.url === 'string' ? parsed.url : parsed.jobUrl;
  if (!isValidHttpUrl(rawUrl)) {
    return {
      ok: false,
      errorCode: 'INVALID_PAYLOAD',
      message: 'URL da vaga ausente ou inválida no payload do bookmarklet.',
    };
  }

  const title = typeof parsed.title === 'string' ? parsed.title.trim() : '';
  const rawContent = typeof parsed.text === 'string'
    ? parsed.text
    : (typeof parsed.content === 'string' ? parsed.content : '');
  const text = rawContent.trim().slice(0, MAX_BOOKMARKLET_TEXT_LENGTH);
  const capturedAt = typeof parsed.capturedAt === 'string' ? parsed.capturedAt.trim() : '';

  return {
    ok: true,
    data: {
      url: rawUrl.trim(),
      title,
      text,
      capturedAt,
    },
  };
}

/**
 * Validates the JSON schema returned by Gemini for Step 1 (`analyzeJob`).
 * @param {object} payload
 * @returns {{ valid: boolean, errors: string[] }}
 */
function validateAnalysisResult(payload) {
  const errors = [];

  if (!isPlainObject(payload)) {
    return { valid: false, errors: ['Payload de análise deve ser um objeto.'] };
  }

  if (!isNonEmptyString(payload.company)) {
    errors.push('Campo "company" deve ser uma string não vazia.');
  }
  if (!isNonEmptyString(payload.role)) {
    errors.push('Campo "role" deve ser uma string não vazia.');
  }
  if (payload.language !== 'PT' && payload.language !== 'EN') {
    errors.push('Campo "language" deve ser "PT" ou "EN".');
  }
  if (!isStringArray(payload.keywords)) {
    errors.push('Campo "keywords" deve ser um array não vazio de strings.');
  } else if (payload.keywords.length > MAX_KEYWORDS) {
    errors.push(`Campo "keywords" deve ter no máximo ${MAX_KEYWORDS} itens.`);
  }

  if (!isPlainObject(payload.gapAnalysis)) {
    errors.push('Campo "gapAnalysis" deve ser um objeto.');
  } else {
    const gapFields = ['hasPracticalContext', 'underHighlighted', 'realGaps'];
    gapFields.forEach((field) => {
      if (!isStringArray(payload.gapAnalysis[field], { allowEmpty: true })) {
        errors.push(`Campo "gapAnalysis.${field}" deve ser um array de strings.`);
      }
    });
  }

  if (!Array.isArray(payload.validationQuestions)) {
    errors.push('Campo "validationQuestions" deve ser um array.');
  } else {
    payload.validationQuestions.forEach((item, index) => {
      if (!isPlainObject(item)) {
        errors.push(`"validationQuestions[${index}]" deve ser um objeto.`);
        return;
      }
      if (!isNonEmptyString(item.id)) {
        errors.push(`"validationQuestions[${index}].id" deve ser uma string não vazia.`);
      }
      if (!isNonEmptyString(item.technology)) {
        errors.push(`"validationQuestions[${index}].technology" deve ser uma string não vazia.`);
      }
      if (!isNonEmptyString(item.reason)) {
        errors.push(`"validationQuestions[${index}].reason" deve ser uma string não vazia.`);
      }
      if (!isNonEmptyString(item.question)) {
        errors.push(`"validationQuestions[${index}].question" deve ser uma string não vazia.`);
      }
      if (typeof item.suggestedDefault !== 'boolean') {
        errors.push(`"validationQuestions[${index}].suggestedDefault" deve ser booleano.`);
      }
    });
  }

  if (!isNonEmptyString(payload.extractedJobSummary)) {
    errors.push('Campo "extractedJobSummary" deve ser uma string não vazia.');
  }

  return {
    valid: errors.length === 0,
    errors,
  };
}

/**
 * Validates the JSON schema returned by Gemini for Step 2 (`generateResume`).
 * @param {object} payload
 * @returns {{ valid: boolean, errors: string[] }}
 */
function validateGeneratedResume(payload) {
  const errors = [];

  if (!isPlainObject(payload)) {
    return { valid: false, errors: ['Payload do currículo gerado deve ser um objeto.'] };
  }

  if (payload.language !== 'PT' && payload.language !== 'EN') {
    errors.push('Campo "language" deve ser "PT" ou "EN".');
  }
  if (!isNonEmptyString(payload.summary)) {
    errors.push('Campo "summary" deve ser uma string não vazia.');
  }

  if (!Array.isArray(payload.experiences) || payload.experiences.length === 0) {
    errors.push('Campo "experiences" deve ser um array não vazio.');
  } else {
    payload.experiences.forEach((exp, index) => {
      if (!isPlainObject(exp)) {
        errors.push(`"experiences[${index}]" deve ser um objeto.`);
        return;
      }
      if (!isNonEmptyString(exp.company)) {
        errors.push(`"experiences[${index}].company" deve ser uma string não vazia.`);
      }
      if (!isNonEmptyString(exp.role)) {
        errors.push(`"experiences[${index}].role" deve ser uma string não vazia.`);
      }
      if (!isNonEmptyString(exp.period)) {
        errors.push(`"experiences[${index}].period" deve ser uma string não vazia.`);
      }
      if (!isStringArray(exp.bullets)) {
        errors.push(`"experiences[${index}].bullets" deve ser um array não vazio de strings.`);
      }
    });
  }

  if (!isStringArray(payload.skills)) {
    errors.push('Campo "skills" deve ser um array não vazio de strings.');
  } else {
    payload.skills.forEach((line, index) => {
      const colonIdx = line.indexOf(':');
      if (colonIdx <= 0 || colonIdx === line.length - 1) {
        errors.push(`"skills[${index}]" deve conter rótulo e valores separados por ":".`);
      } else {
        const label = line.slice(0, colonIdx).trim();
        const items = line.slice(colonIdx + 1).trim();
        if (label.length === 0 || items.length === 0) {
          errors.push(`"skills[${index}]" deve ter texto não vazio antes e depois de ":".`);
        }
      }
      if (/\(\s*em\s+(estudo|aprendizado)\s*\)/i.test(line)) {
        errors.push(`"skills[${index}]" não pode conter "(Em estudo)" ou "(em aprendizado)".`);
      }
    });
  }

  if (!isStringArray(payload.education)) {
    errors.push('Campo "education" deve ser um array não vazio de strings.');
  }
  if (!isNonEmptyString(payload.courses)) {
    errors.push('Campo "courses" deve ser uma string não vazia.');
  }
  if (!isStringArray(payload.highlightsSummary)) {
    errors.push('Campo "highlightsSummary" deve ser um array não vazio de strings.');
  }
  if (typeof payload.gapsSummary !== 'string') {
    errors.push('Campo "gapsSummary" deve ser uma string.');
  }

  return {
    valid: errors.length === 0,
    errors,
  };
}

/**
 * Checks whether an HTTP status code is eligible for retry with exponential backoff.
 * @param {number} statusCode
 * @returns {boolean}
 */
function isRetryableHttpStatus(statusCode) {
  return Number.isInteger(statusCode) && RETRYABLE_HTTP_STATUSES.includes(statusCode);
}

/**
 * Calculates exponential backoff delay with additive jitter in milliseconds.
 * @param {number} attempt Zero-based retry attempt index (0, 1, 2, ...).
 * @param {{
 *   baseDelayMs?: number,
 *   maxDelayMs?: number,
 *   jitterRatio?: number,
 *   randomFn?: () => number
 * }} [options]
 * @returns {number}
 */
function calculateBackoffDelayMs(attempt, options) {
  if (!Number.isInteger(attempt) || attempt < 0) {
    throw new RangeError('attempt deve ser um inteiro maior ou igual a 0.');
  }

  const opts = isPlainObject(options) ? options : {};
  const baseDelayMs = typeof opts.baseDelayMs === 'number' ? opts.baseDelayMs : 1000;
  const maxDelayMs = typeof opts.maxDelayMs === 'number' ? opts.maxDelayMs : 16000;
  const jitterRatio = typeof opts.jitterRatio === 'number' ? opts.jitterRatio : 0.25;
  const randomFn = typeof opts.randomFn === 'function' ? opts.randomFn : Math.random;

  const exponential = Math.min(maxDelayMs, baseDelayMs * Math.pow(2, attempt));
  const jitter = exponential * jitterRatio * randomFn();
  return Math.min(maxDelayMs, Math.round(exponential + jitter));
}

/**
 * Normalizes extracted job text (CRLF -> LF, collapses excessive blank lines, trims, caps length).
 * @param {string} rawText
 * @param {number} [maxLength]
 * @returns {string}
 */
function cleanExtractedText(rawText, maxLength) {
  if (typeof rawText !== 'string') {
    return '';
  }
  const limit = typeof maxLength === 'number' && maxLength > 0
    ? maxLength
    : MAX_BOOKMARKLET_TEXT_LENGTH;
  return rawText
    .replace(/\r\n?/g, '\n')
    .replace(/\n{3,}/g, '\n\n')
    .trim()
    .slice(0, limit);
}

/**
 * Validates up to MAX_SCREENSHOT_COUNT Base64 image attachments for multimodal Gemini calls.
 * @param {Array<{ mimeType?: string, data: string }>} images
 * @returns {{
 *   valid: boolean,
 *   normalized: Array<{ mimeType: string, data: string }>,
 *   errors: string[]
 * }}
 */
function validateImageAttachments(images) {
  const errors = [];
  const normalized = [];

  if (!Array.isArray(images) || images.length === 0) {
    return {
      valid: false,
      normalized: [],
      errors: ['Envie entre 1 e 4 imagens para análise multimodal.'],
    };
  }

  if (images.length > MAX_SCREENSHOT_COUNT) {
    return {
      valid: false,
      normalized: [],
      errors: [`Limite máximo de ${MAX_SCREENSHOT_COUNT} imagens excedido.`],
    };
  }

  images.forEach((item, index) => {
    if (!isPlainObject(item) || typeof item.data !== 'string') {
      errors.push(`Imagem ${index + 1} inválida: campo "data" ausente.`);
      return;
    }

    let mimeType = typeof item.mimeType === 'string' ? item.mimeType.trim().toLowerCase() : '';
    let base64Data = item.data.trim();

    const dataUrlMatch = /^data:([^;]+);base64,(.*)$/i.exec(base64Data);
    if (dataUrlMatch) {
      if (!mimeType) {
        mimeType = dataUrlMatch[1].trim().toLowerCase();
      }
      base64Data = dataUrlMatch[2];
    }

    base64Data = base64Data.replace(/\s+/g, '');

    if (!ALLOWED_IMAGE_MIME_TYPES.includes(mimeType)) {
      errors.push(`Imagem ${index + 1}: tipo MIME "${mimeType || 'desconhecido'}" não permitido.`);
      return;
    }

    if (base64Data.length === 0 || base64Data.length > MAX_IMAGE_BASE64_LENGTH) {
      errors.push(`Imagem ${index + 1}: tamanho Base64 inválido ou acima do limite.`);
      return;
    }

    if (base64Data.length % 4 !== 0 || !/^[A-Za-z0-9+/]+={0,2}$/.test(base64Data)) {
      errors.push(`Imagem ${index + 1}: conteúdo Base64 malformado.`);
      return;
    }

    normalized.push({ mimeType, data: base64Data });
  });

  const totalLength = normalized.reduce((sum, img) => sum + img.data.length, 0);
  if (totalLength > MAX_TOTAL_IMAGES_BASE64_LENGTH) {
    errors.push('Tamanho total das imagens excede o limite da requisição. Comprima ou envie menos prints.');
  }

  return {
    valid: errors.length === 0,
    normalized: errors.length === 0 ? normalized : [],
    errors,
  };
}

/**
 * Returns the canonical section heading in PT or EN.
 * @param {'summary'|'experience'|'skills'|'education'|'courses'} sectionKey
 * @param {string} language
 * @returns {string}
 */
function getSectionHeading(sectionKey, language) {
  const langKey = language === 'EN' ? 'EN' : 'PT';
  const map = SECTION_HEADINGS[langKey];
  if (!Object.prototype.hasOwnProperty.call(map, sectionKey)) {
    throw new Error(`Seção de currículo desconhecida: ${sectionKey}`);
  }
  return map[sectionKey];
}

/**
 * Normalizes text for accent-insensitive section heading detection.
 * @param {string} text
 * @returns {string}
 */
function normalizeHeadingForMatch(text) {
  if (typeof text !== 'string') {
    return '';
  }
  return text
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/\s+/g, ' ')
    .replace(/\s*:\s*$/, '')
    .trim()
    .toUpperCase();
}

/**
 * Detects whether a paragraph matches one of the 5 ATS resume anchor headings (PT or EN).
 * @param {string} paragraphText
 * @returns {'summary'|'experience'|'skills'|'education'|'courses'|null}
 */
function detectSectionAnchor(paragraphText) {
  const normalized = normalizeHeadingForMatch(paragraphText);
  if (!normalized) {
    return null;
  }

  const keys = ['summary', 'experience', 'skills', 'education', 'courses'];
  for (let i = 0; i < keys.length; i += 1) {
    const key = keys[i];
    if (
      normalized === normalizeHeadingForMatch(SECTION_HEADINGS.PT[key]) ||
      normalized === normalizeHeadingForMatch(SECTION_HEADINGS.EN[key])
    ) {
      return key;
    }
  }
  return null;
}

/**
 * Generates a unique application ID in the format APP-YYYYMMDD-XXXX.
 * @param {Date} [date]
 * @param {string} [randomSuffix] Optional 4-char uppercase alphanumeric suffix for deterministic tests.
 * @returns {string}
 */
function generateApplicationId(date, randomSuffix) {
  const targetDate = date instanceof Date && !Number.isNaN(date.getTime()) ? date : new Date();
  const year = String(targetDate.getFullYear());
  const month = String(targetDate.getMonth() + 1).padStart(2, '0');
  const day = String(targetDate.getDate()).padStart(2, '0');

  let suffix = '';
  if (typeof randomSuffix === 'string' && /^[A-Z0-9]{4}$/.test(randomSuffix.trim().toUpperCase())) {
    suffix = randomSuffix.trim().toUpperCase();
  } else {
    const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
    for (let i = 0; i < 4; i += 1) {
      suffix += alphabet.charAt(Math.floor(Math.random() * alphabet.length));
    }
  }

  return `APP-${year}${month}${day}-${suffix}`;
}

/**
 * Builds edit and direct PDF export URLs for a Google Doc ID.
 * @param {string} docId
 * @returns {{ docUrl: string, pdfUrl: string }}
 */
function buildDocUrls(docId) {
  if (!isNonEmptyString(docId)) {
    throw new Error('docId deve ser uma string não vazia.');
  }
  const cleanId = encodeURIComponent(docId.trim());
  return {
    docUrl: `https://docs.google.com/document/d/${cleanId}/edit`,
    pdfUrl: `https://docs.google.com/document/d/${cleanId}/export?format=pdf`,
  };
}

/**
 * Deterministic key-sorted JSON serializer for stable idempotency hashing.
 * @param {*} value
 * @returns {string}
 */
function stableStringify(value) {
  if (value === null || typeof value !== 'object') {
    return JSON.stringify(value);
  }
  if (Array.isArray(value)) {
    return `[${value.map((item) => stableStringify(item)).join(',')}]`;
  }
  const keys = Object.keys(value).sort();
  const entries = keys.map((key) => `${JSON.stringify(key)}:${stableStringify(value[key])}`);
  return `{${entries.join(',')}}`;
}

/**
 * Builds a short deterministic cache key (safe for Apps Script CacheService 250-char limit).
 * @param {string} operation
 * @param {*} payload
 * @returns {string}
 */
function buildIdempotencyKey(operation, payload) {
  const safeOp = isNonEmptyString(operation) ? operation.trim().replace(/[^A-Za-z0-9_-]/g, '_') : 'op';
  const serialized = `${safeOp}:${stableStringify(payload === undefined ? null : payload)}`;
  let hash = 0x811c9dc5;
  for (let i = 0; i < serialized.length; i += 1) {
    hash ^= serialized.charCodeAt(i);
    hash = Math.imul(hash, 0x01000193);
  }
  const hex = (hash >>> 0).toString(16).padStart(8, '0');
  return `idem:${safeOp}:${hex}`;
}

/**
 * Serializes a Backlog application record into the exact 14-column array (A..N).
 * @param {object} record
 * @returns {Array<string>}
 */
function serializeBacklogRow(record) {
  if (!isPlainObject(record)) {
    throw new Error('Registro do backlog deve ser um objeto.');
  }

  const keywords = Array.isArray(record.keywords) ? record.keywords : [];
  const highlights = Array.isArray(record.highlightsSummary)
    ? record.highlightsSummary.join('\n')
    : (typeof record.highlightsSummary === 'string' ? record.highlightsSummary : '');
  const metadata = isPlainObject(record.metadata) ? record.metadata : {};

  const cells = [
    typeof record.id === 'string' ? record.id : '',
    typeof record.createdAt === 'string' ? record.createdAt : '',
    typeof record.company === 'string' ? record.company : '',
    typeof record.role === 'string' ? record.role : '',
    record.language === 'EN' ? 'EN' : 'PT',
    isValidApplicationStatus(record.status) ? record.status : 'Gerado',
    typeof record.jobUrl === 'string' ? record.jobUrl : '',
    typeof record.docUrl === 'string' ? record.docUrl : '',
    typeof record.pdfUrl === 'string' ? record.pdfUrl : '',
    JSON.stringify(keywords),
    highlights,
    typeof record.gapsSummary === 'string' ? record.gapsSummary : '',
    typeof record.notes === 'string' ? record.notes : '',
    JSON.stringify(metadata),
  ];
  return cells.map((value) => toSheetSafeText(value));
}

/**
 * Deserializes a 14-column Backlog row (A..N) into a structured application object.
 * @param {Array<*>} row
 * @returns {object}
 */
function deserializeBacklogRow(row) {
  const safeRow = Array.isArray(row) ? row : [];
  const cell = (idx) => {
    const value = safeRow[idx];
    if (value === null || value === undefined) {
      return '';
    }
    // Sheets may auto-convert ISO strings into Date cells; keep a sortable ISO string.
    if (Object.prototype.toString.call(value) === '[object Date]') {
      return Number.isNaN(value.getTime()) ? '' : value.toISOString();
    }
    const str = String(value);
    if (str.length >= 2 && str[0] === "'" && /^[=+\-@]/.test(str[1])) {
      return str.slice(1);
    }
    return str;
  };

  let keywords = [];
  if (isNonEmptyString(cell(9))) {
    try {
      const parsedKeywords = JSON.parse(cell(9));
      if (Array.isArray(parsedKeywords)) {
        keywords = parsedKeywords;
      }
    } catch {
      keywords = [];
    }
  }

  let metadata = {};
  if (isNonEmptyString(cell(13))) {
    try {
      const parsedMeta = JSON.parse(cell(13));
      if (isPlainObject(parsedMeta)) {
        metadata = parsedMeta;
      }
    } catch {
      metadata = {};
    }
  }

  const rawStatus = cell(5);
  return {
    id: cell(0),
    createdAt: cell(1),
    company: cell(2),
    role: cell(3),
    language: cell(4) === 'EN' ? 'EN' : 'PT',
    status: isValidApplicationStatus(rawStatus) ? rawStatus : 'Gerado',
    jobUrl: cell(6),
    docUrl: cell(7),
    pdfUrl: cell(8),
    keywords,
    highlightsSummary: cell(10),
    gapsSummary: cell(11),
    notes: cell(12),
    metadata,
  };
}

/**
 * Normalizes a Gemini model name from ScriptProperties (strips an optional "models/" prefix).
 * @param {string} modelName
 * @returns {string}
 */
function normalizeModelName(modelName) {
  if (!isNonEmptyString(modelName)) {
    return '';
  }
  return modelName.trim().replace(/^models\//i, '').trim();
}

/**
 * Prevents Google Sheets from interpreting text as a formula (formula injection and
 * "#ERROR!" cells for summaries starting with "-" bullets). Sheets stores the value
 * without the leading apostrophe, so reads return the original text.
 * @param {*} value
 * @returns {*}
 */
function toSheetSafeText(value) {
  if (typeof value === 'string' && /^[=+\-@]/.test(value)) {
    return `'${value}`;
  }
  return value;
}

/**
 * Heuristic 1-page guard: compares the edited resume against the cloned 1-page base.
 * Apps Script cannot measure rendered pages, so growth in characters/paragraphs is used
 * as a proxy to warn the user to review the document before applying.
 * @param {{ baseChars: number, baseParagraphs: number, newChars: number, newParagraphs: number }} stats
 * @param {{ charTolerance?: number, extraParagraphTolerance?: number }} [options]
 * @returns {{ atRisk: boolean, charRatio: number, paragraphDelta: number }}
 */
function assessOnePageRisk(stats, options) {
  const safe = isPlainObject(stats) ? stats : {};
  const opts = isPlainObject(options) ? options : {};
  const charTolerance = typeof opts.charTolerance === 'number' ? opts.charTolerance : 1.05;
  const extraParagraphTolerance = typeof opts.extraParagraphTolerance === 'number'
    ? opts.extraParagraphTolerance
    : 2;

  const baseChars = Number(safe.baseChars) || 0;
  const newChars = Number(safe.newChars) || 0;
  const paragraphDelta = (Number(safe.newParagraphs) || 0) - (Number(safe.baseParagraphs) || 0);
  const charRatio = baseChars > 0 ? Math.round((newChars / baseChars) * 100) / 100 : 0;

  return {
    atRisk: (baseChars > 0 && charRatio > charTolerance) || paragraphDelta > extraParagraphTolerance,
    charRatio,
    paragraphDelta,
  };
}

